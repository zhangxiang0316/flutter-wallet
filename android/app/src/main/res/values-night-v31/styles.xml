<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ dark mode splash uses the same white launch color. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/empty_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_background_color</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background_color</item>
        <item name="android:statusBarColor">@color/launch_background_color</item>
    </style>
</resources>
